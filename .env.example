# ===== FPT (Gemma) =====
# File nay ĐƯỢC GIT THEO DOI — chi dien placeholder, KHONG BAO GIO dien key
# that. Key that chi nam trong .env (da gitignore).
FPT_API_KEY=
FPT_BASE_URL=https://mkp-api.fptcloud.com
FPT_MODEL=gemma-4-31B-it
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ===== Azure Document Intelligence (OCR) =====
AZURE_ENDPOINT=https://<ten-tai-nguyen>.cognitiveservices.azure.com/
AZURE_KEY=

ELIS_BASE_URL=https://apitest.fpt.com/uat-elis-gw
ELIS_FILE_BASE_URL=https://apitest.fpt.com/uat-elis-gw
ELIS_API_KEY=

# Môi trường đang trỏ tới: UAT hoặc Production
ENV=UAT

# ===== Tham số vận hành =====
RETRY_COUNT=3
RETRY_DELAY_SECONDS=5
POLL_INTERVAL_SECONDS=5
TIMEOUT_SECONDS=60


# ===== Luật thời gian hoàn thành (đổi khi sang năm mới) =====
VALID_FROM=2026-01-01
VALID_TO=2026-09-30

# ===== Kho luu chung chi (phuc vu danh gia lai) =====
# 1 = giu lai anh + thong tin getCert moi lan tai ve, de chay lai bo danh gia
#     ma khong can eLIS (data that chi di qua eLIS DUNG MOT LAN).
# 0 = khong luu. MAC DINH 0 vi chung chi that chua ten/ma/email nhan vien.
SAVE_CERTIFICATES=0
ARCHIVE_DIR=cert_archive

# ===== Luật khớp tên khóa học =====
# loose  : người nhập chỉ cần là TẬP CON của tên khóa trên ảnh cũng khớp.
# strict : tên khóa phải trùng KHỚP HOÀN TOÀN (cùng tập từ).
COURSE_MATCH_MODE=loose

# ===== Gửi báo cáo qua email =====
#
# SMTP_PASSWORD luôn là App Password, không phải mật khẩu đăng nhập.
#   Gmail      : bật Xác minh 2 bước -> myaccount.google.com/apppasswords
#                -> tạo App Password 16 ký tự, DÁN LIỀN (bỏ dấu cách).
#   Office 365 : cần MFA + admin bật SMTP AUTH cho hộp thư.
#
# SMTP_USER và SMTP_USERNAME là MỘT (code nhận cả hai tên).
# MAIL_TO, MANAGER_EMAIL cũng vậy.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Địa chỉ From. Để trống = dùng SMTP_USER. Gmail LUÔN ghi đè trường này
# thành tài khoản đã đăng nhập, nên điền địa chỉ khác cũng không có tác dụng.
MAIL_FROM=
MAIL_TO=

# ===== Lịch gửi báo cáo tự động =====
# off      : không tự gửi (chỉ gửi tay bằng send_report.py --send)
# daily    : gửi MỖI NGÀY, nội dung là 7 ngày gần nhất
# weekly   : gửi mỗi tuần, nội dung là 7 ngày gần nhất
# monthly  : gửi mỗi tháng, nội dung là trọn tháng TRƯỚC
#
# daily và weekly cùng nội dung, khác tần suất gửi. Nội dung là 7 ngày chứ
# không phải 1 ngày vì biểu đồ một điểm thì không nói lên điều gì.
REPORT_SCHEDULE=off
# Giờ gửi (HH:MM, giờ VN)
REPORT_TIME=18:00
# weekly: gửi thứ mấy. 0=Thứ Hai ... 4=Thứ Sáu ... 6=Chủ nhật
REPORT_WEEKDAY=4
# monthly: gửi ngày mấy (báo cáo cho THÁNG TRƯỚC)
REPORT_MONTHDAY=1
# Mốc gom số liệu trong biểu đồ: day | week | month. Rỗng = tự chọn.
# Đặt thô hơn kỳ báo cáo sẽ tự bị hạ xuống (week cho kỳ 7 ngày -> day),
# vì gom 7 ngày theo tuần chỉ cho ra đúng một cột.
REPORT_BUCKET=

# ===== Thử lại ca hỏng kỹ thuật =====
#
# LUAT HR: ca hong ky thuat (eLIS khong tra file, Azure timeout, AI loi, het
# tien/het han muc) KHONG BAO GIO bi nop REJECTED. Loi he thong thi ca day
# cung loi, nop REJECTED la tu choi oan hang loat chung chi hop le.
#
# Chung chi o lai WAITING tren eLIS va duoc thu lai MAI, khong gioi han so
# lan. Khong con nhanh bo cuoc.

# Nghi bao nhieu phut truoc khi thu lai cung mot chung chi.
# 2 phut: du de eLIS/Azure chap vai giay tu qua, ma van phuc hoi nhanh.
TECHNICAL_RETRY_COOLDOWN_MINUTES=2

# Hong toi lan thu may thi GUI EMAIL canh bao (van thu tiep, khong bo cuoc).
# Voi gian cach 2 phut thi 5 lan ~ 10 phut hong lien tuc moi gui thu.
#
# Ten cu TECHNICAL_RETRY_MAX van nhan, nhung NGHIA DA DOI: truoc la "bo cuoc
# sau ngan nay lan", gio la "bao nguoi sau ngan nay lan".
TECHNICAL_ALERT_AFTER=5

# ===== Email canh bao loi he thong =====
# KHAC MAIL_TO: canh bao la viec phai xu ly ngay, bao cao la so lieu doc cuoi
# ngay. Tron hai luong vao mot hop thu thi canh bao bi chim giua bao cao.
ALERT_MAIL_TO=hoabd5@fpt.com

# Nhip NHAC LAI khi su co van con: moi ngan nay tieng mot thu.
# KHONG lam cham thu DAU TIEN — thu dau di ngay khi cham TECHNICAL_ALERT_AFTER.
#
# BAT BUOC PHAI CO: job thu lai moi 2 phut va moi vong deu tinh lai ai da vuot
# nguong. Khong chan thi mot su co keo dai 6 tieng sinh ra 180 thu giong het
# nhau, va nguoi nhan se tao rule loc bo ngay trong ngay dau.
ALERT_COOLDOWN_HOURS=1

# ===== Chống nộp trùng khóa học =====
# 1 = bật, 0 = tắt. Bật thì chứng chỉ của khóa nhân viên ĐÃ được duyệt sẽ bị
# từ chối ngay với lý do "Cán bộ nộp trùng khóa học", không tốn lượt LLM nào.
DUPLICATE_CHECK=1
# Bao lâu nạp lại lịch sử đã duyệt từ eLIS (phút).
HISTORY_REFRESH_MINUTES=60
