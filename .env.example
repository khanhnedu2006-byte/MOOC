# ===== FPT (Gemma) =====
FPT_API_KEY=dien_key_fpt_cua_ban
FPT_BASE_URL=https://mkp-api.fptcloud.com
FPT_MODEL=gemma-4-31B-it
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ===== Azure Document Intelligence (OCR) =====
AZURE_ENDPOINT=https://ten-resource.cognitiveservices.azure.com/
AZURE_KEY=dien_key_azure_cua_ban


# =====================================================================
# ELIS Partner API — AI Certificate Scan (3 API)
# Tài liệu: "Partner Integration Guide — AI Certificate Scan v1.1"
# Giá trị thật do đội eLIS cấp qua kênh bảo mật. Chỉ gọi HTTPS,
# chỉ từ IP nằm trong allowlist đã đăng ký. KHÔNG commit file .env.
# =====================================================================

# ---------------------------------------------------------------------
# API ① getCert — lấy danh sách chứng chỉ chờ duyệt
# API ③ ProcessUserCourseStatus — nộp kết quả APPROVED/REJECTED
# Hai API này dùng CHUNG base + prefix + key bên dưới.
#
# curl mentor gửi (API ①):
#   curl --location 'https://apitest.fpt.com/uat-elis-gw/api/v1/UserCourse/elearning/getCert?page=1&size=10&status=WAITING' \
#     --header 'apikey: <KEY>'
#
# curl mentor gửi (API ③):
#   curl --location 'https://apitest.fpt.com/uat-elis-gw/api/v1/UserCourse/ProcessUserCourseStatus' \
#     --header 'apikey: <KEY>' \
#     --header 'Content-Type: application/json' \
#     --data '[{
#         "id": "76ac79da-79f8-428d-bbd5-d93d4d74f0c5",
#         "certificate_id": "7544d3bf-90f2-47f3-9c9d-532ee19e0245",
#         "status": "APPROVED",
#         "courseId": "e0986fc2-3541-4f12-aa0d-823a8c4af47d",
#         "employeeId": "00332383",
#         "comment": "Chứng chỉ hop lệ",
#         "comment_cer": "AI [Extracted Information]"
#     }]'
#
# Cách tách URL thành config:
#   https://apitest.fpt.com  /uat-elis-gw  /api/v1/UserCourse/...
#   └─ API_BASE_URL ──────┘  └KONG_API_PREFIX┘  └─ nằm trong code ─┘
#
# LƯU Ý: employeeId là CHUỖI, có thể có số 0 ở đầu ("00332383").
# Không được ép sang kiểu số — sẽ mất số 0 và ELIS trả về failList.
# ---------------------------------------------------------------------
API_BASE_URL=https://apitest.fpt.com
KONG_API_PREFIX=/uat-elis-gw
API_KEY=dien_key_tu_header_apikey
API_KEY_HEADER=apikey

# ---------------------------------------------------------------------
# API ② download-certificates-zip — tải file chứng chỉ (tối đa 20 cặp/lần)
#
# curl mentor gửi:
#   curl --location 'https://apitest.fpt.com/uat-elis-gw/api/v1/files/download-certificates-zip' \
#     --header 'apikey: <KEY>' \
#     --header 'Content-Type: application/json' \
#     --data '[{
#         "UserCourseId": "3cf295a5-7aed-4401-ab47-f16753e6b184",
#         "certificate_id": "904bf167-0fef-47a7-b10c-6e2352c86093"
#     }]'
#
# Trên UAT, FileService nằm CÙNG host và CÙNG prefix với eLIS API
# (đều là apitest.fpt.com/uat-elis-gw) và dùng CHUNG một key. Tài liệu
# tách riêng ba biến này vì môi trường khác có thể mount ở chỗ khác.
#
# KONG_API_KEY để TRỐNG = tự dùng chung API_KEY ở trên. Chỉ điền khi eLIS
# cấp key riêng cho FileService. Để trống thì khỏi phải dán key hai lần,
# tránh dán lệch một chỗ rồi ngồi dò lỗi 403.
#
# LƯU Ý tên field trong body: "UserCourseId" chữ U hoa, "certificate_id"
# chữ thường có gạch dưới — tài liệu ghi rõ là case-sensitive.
# ---------------------------------------------------------------------
KONG_BASE_URL=https://apitest.fpt.com
KONG_FILE_PREFIX=/uat-elis-gw
KONG_API_KEY=

# Môi trường đang trỏ tới: UAT hoặc Production
ENV=UAT


# ===== Nhịp vòng lặp =====
# run.py chạy liên tục, mỗi vòng hỏi ELIS xem có chứng chỉ chờ duyệt không.
# Nghỉ bao lâu giữa hai vòng phụ thuộc vòng vừa rồi CÓ VIỆC hay KHÔNG:
#
#   Có việc -> nghỉ POLL_INTERVAL_GIAY (ngắn). Vừa có người nộp thì thường
#              còn cái khác đang xếp hàng, xử lý nốt cho nhanh.
#   Rảnh    -> nghỉ POLL_INTERVAL_RONG_GIAY (dài hơn). Tránh gọi API liên
#              tục vô ích, nhất là ngoài giờ làm việc.
#
# Tải ZIP hỏng cũng tính là "có việc" -> nghỉ ngắn để thử lại sớm.
POLL_INTERVAL_GIAY=10
POLL_INTERVAL_RONG_GIAY=60

# Số lần thử lại khi gọi API lỗi mạng (áp dụng cho cả 3 API)
SO_LAN_RETRY=3

# ===== Luật thời gian hoàn thành (đổi khi sang năm mới) =====
THOI_GIAN_HOP_LE_TU=2026-01-01
THOI_GIAN_HOP_LE_DEN=2026-09-30

#==== Luật lỏng chặt lỏng abcd/abcde vẫn được chấp nhận. Chặt yêu cầu abcd/abcd
#đổi thành chat nếu muốn
CHE_DO_KHOP_KHOA_HOC=long
