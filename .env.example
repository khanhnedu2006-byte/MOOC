# ===== FPT (Gemma) =====
FPT_API_KEY=dien_key_fpt_cua_ban
FPT_BASE_URL=https://mkp-api.fptcloud.com
FPT_MODEL=gemma-4-31B-it
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ===== Azure Document Intelligence (OCR) =====
AZURE_ENDPOINT=https://ten-resource.cognitiveservices.azure.com/
AZURE_KEY=dien_key_azure_cua_ban


ELIS_BASE_URL=https://apitest.fpt.com/uat-elis-gw
ELIS_FILE_BASE_URL=https://apitest.fpt.com/uat-elis-gw
ELIS_API_KEY=key

# Môi trường đang trỏ tới: UAT hoặc Production
ENV=UAT

# ===== Tham số vận hành =====
SO_LAN_RETRY=3
RETRY_DELAY_GIAY=5
POLL_INTERVAL_GIAY=5
TIMEOUT_GIAY=60

# So chung chi xu ly trong MOT lo: tai file -> scan -> nop ket qua.
# Lo nho = mat it cong hon khi eLIS loi giua chung; lo lon = it request hon.
# eLIS gioi han 20 cap moi request tai file, gia tri > 20 se bi ep ve 20.
KICH_THUOC_LO=1

# ===== Luật thời gian hoàn thành (đổi khi sang năm mới) =====
THOI_GIAN_HOP_LE_TU=2026-01-01
THOI_GIAN_HOP_LE_DEN=2026-09-30

#==== Luật lỏng chặt lỏng abcd/abcde vẫn được chấp nhận. Chặt yêu cầu abcd/abcd
#đổi thành chat nếu muốn
CHE_DO_KHOP_KHOA_HOC=long

SMTP_USER=<email công ty của bạn>
SMTP_PASSWORD=<App Password>
MAIL_DEN=<email mentor>