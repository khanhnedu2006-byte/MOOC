# ===== FPT (Gemma) =====
FPT_API_KEY=
FPT_BASE_URL=https://mkp-api.fptcloud.com
FPT_MODEL=gemma-4-31B-it
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ===== Azure Document Intelligence (OCR) =====
AZURE_ENDPOINT=https://<ten-tai-nguyen>.cognitiveservices.azure.com/
AZURE_KEY=

# ===== OCR tầng 2: chọn nhà cung cấp =====
# azure    : Azure Document Intelligence (bậc F0: 500 trang/tháng)
# ocrspace : OCR.space (miễn phí 25.000 lượt/tháng, không cần thẻ)
#
# CÂN NHẮC VỀ DỮ LIỆU: chọn ocrspace là ảnh chứng chỉ — có tên, mã và email
# nhân viên — đi ra máy chủ bên thứ ba. Hỏi người phụ trách trước khi đổi.
OCR_PROVIDER=azure

# Lấy key miễn phí tại https://ocr.space/ocrapi (chỉ cần khi dùng ocrspace)
OCRSPACE_API_KEY=

# 2 = khai ngôn ngữ bên dưới | 3 = tự nhận diện 200+ ngôn ngữ
# Engine 1 KHÔNG đọc được tiếng Việt.
OCRSPACE_ENGINE=2

# Mã ngôn ngữ cho engine 2. Chỉ nhận MỘT mã, không có "vnm+eng" như
# Tesseract; chứng chỉ song ngữ thì thử "auto". Engine 3 bỏ qua dòng này.
OCRSPACE_LANGUAGE=vnm

ELIS_BASE_URL=https://apitest.fpt.com/uat-elis-gw
ELIS_FILE_BASE_URL=https://apitest.fpt.com/uat-elis-gw
ELIS_API_KEY=

# Môi trường đang trỏ tới: UAT hoặc Production
ENV=UAT

# ===== Tham số vận hành =====
RETRY_COUNT=3
RETRY_DELAY_SECONDS=5
POLL_INTERVAL_SECONDS=5
TIMEOUT_SECONDS=60

# ===== Luật thời gian hoàn thành (đổi khi sang năm mới) =====
VALID_FROM=2026-01-01
VALID_TO=2026-09-30

# ===== Kho luu chung chi (phuc vu danh gia lai) =====
SAVE_CERTIFICATES=0
ARCHIVE_DIR=cert_archive

# ===== Luật khớp tên khóa học =====

COURSE_MATCH_MODE=loose

# ===== Gửi báo cáo qua email =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Nhiều người nhận: cách nhau bằng dấu phẩy hoặc chấm phẩy
# vd MAIL_TO=a@fpt.com, b@fpt.com; c@fpt.com
MAIL_TO=

# ===== Lịch gửi báo cáo tự động =====
REPORT_SCHEDULE=off
# Giờ gửi (HH:MM, giờ VN)
REPORT_TIME=18:00
# weekly: gửi thứ mấy. 0=Thứ Hai ... 4=Thứ Sáu ... 6=Chủ nhật
REPORT_WEEKDAY=4
# monthly: gửi ngày mấy (báo cáo cho THÁNG TRƯỚC)
REPORT_MONTHDAY=1
# Mốc gom số liệu trong biểu đồ: day | week | month. Rỗng = tự chọn.
REPORT_BUCKET=

# ===== Thử lại ca hỏng kỹ thuật =====
TECHNICAL_RETRY_COOLDOWN_MINUTES=2

TECHNICAL_ALERT_AFTER=5

# ===== Email canh bao loi he thong =====
ALERT_MAIL_TO= 

# Nhip NHAC LAI khi su co van con: moi ngan nay tieng mot thu.
ALERT_COOLDOWN_HOURS=1

# ===== Chống nộp trùng khóa học =====
DUPLICATE_CHECK=1

# ===== Bỏ qua theo nhà cung cấp (getCert.providerName) =====
# Nhiều provider cách nhau dấu phẩy; để rỗng = không bỏ qua provider nào.
SKIP_PROVIDERS=Udacity
